@model List<BarberManager.Web.Models.ClienteViewModel>
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2 mb-0">Clientes</h1><a class="btn btn-dark" asp-action="Create">Nuevo cliente</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-info">@mensaje</div> }
@if (ViewBag.ErrorApi is string errorApi) { <div class="alert alert-warning">@errorApi</div> }
<form method="get" class="list-search mb-3" role="search">
    <label class="visually-hidden" for="buscar">Buscar clientes</label>
    <input id="buscar" name="buscar" class="form-control" type="search" value="@ViewData["Buscar"]" placeholder="Buscar por nombre, teléfono o correo" />
    <button class="btn btn-outline-dark" type="submit">Buscar</button>
</form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Notas</th><th></th></tr></thead><tbody>@foreach (var cliente in Model) { <tr><td>@cliente.Nombre</td><td>@cliente.Telefono</td><td>@cliente.Correo</td><td>@cliente.Notas</td><td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@cliente.Id">Historial</a><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@cliente.Id">Editar</a></td></tr>}</tbody></table></div></div>
@if (!Model.Any()) { <p class="text-muted mt-3">Todavía no hay clientes cargados.</p> }
