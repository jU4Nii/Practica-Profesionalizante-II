@model List<BarberManager.Web.Models.PeluqueroViewModel>
@{ ViewData["Title"] = "Peluqueros"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2 mb-0">Peluqueros</h1><a class="btn btn-dark" asp-action="Create">Nuevo peluquero</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-info">@mensaje</div> }
@if (ViewBag.ErrorApi is string errorApi) { <div class="alert alert-warning">@errorApi</div> }
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var peluquero in Model) { <tr><td>@peluquero.Nombre</td><td>@peluquero.Correo</td><td>@peluquero.Telefono</td><td>@(peluquero.EsAdmin ? "Administrador" : "Peluquero")</td><td>@(peluquero.EstaActivo ? "Activo" : "Inactivo")</td><td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@peluquero.Id">Editar</a><form class="d-inline" asp-action="Delete" asp-route-id="@peluquero.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></td></tr> }
</tbody></table></div></div>
@if (!Model.Any()) { <p class="text-muted mt-3">Todavía no hay peluqueros cargados.</p> }
