@model BarberManager.Web.Models.EditarTurnoViewModel
@{ ViewData["Title"] = "Reprogramar turno"; }
<h1 class="h2 mb-4">Reprogramar turno</h1>
<div class="card form-card"><div class="card-body"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="IdCliente" class="form-label">Cliente</label><select asp-for="IdCliente" asp-items="Model.Clientes" class="form-select"></select></div><div class="mb-3"><label asp-for="IdPeluquero" class="form-label">Peluquero</label><select asp-for="IdPeluquero" asp-items="Model.Peluqueros" class="form-select"></select></div><div class="mb-3"><label asp-for="Fecha" class="form-label"></label><input asp-for="Fecha" class="form-control" /></div><div class="mb-4"><label asp-for="Hora" class="form-label"></label><input asp-for="Hora" class="form-control" type="time" /><span asp-validation-for="Hora" class="text-danger"></span></div><button class="btn btn-dark" type="submit">Guardar cambios</button><a class="btn btn-outline-secondary ms-2" asp-action="Index">Cancelar</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
