@model BarberManager.Web.Models.NuevoTurnoViewModel
@{ ViewData["Title"] = "Nuevo turno"; }
<h1 class="h2 mb-4">Nuevo turno</h1>
<div class="card form-card"><div class="card-body"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="IdCliente" class="form-label">Cliente</label><select asp-for="IdCliente" asp-items="Model.Clientes" class="form-select"><option value="0">Seleccioná un cliente</option></select><span asp-validation-for="IdCliente" class="text-danger"></span></div><div class="mb-3"><label asp-for="IdPeluquero" class="form-label">Peluquero</label><select asp-for="IdPeluquero" asp-items="Model.Peluqueros" class="form-select"><option value="0">Seleccioná un peluquero</option></select><span asp-validation-for="IdPeluquero" class="text-danger"></span></div><div class="mb-3"><label asp-for="Fecha" class="form-label"></label><input asp-for="Fecha" class="form-control" /></div><div class="mb-3"><label asp-for="Hora" class="form-label"></label><input asp-for="Hora" class="form-control" type="time" /><span asp-validation-for="Hora" class="text-danger"></span></div><div class="mb-3"><label asp-for="IdServicios" class="form-label">Servicios</label><select asp-for="IdServicios" asp-items="Model.Servicios" class="form-select" multiple size="4"></select><div class="form-text">Podés seleccionar varios servicios.</div></div><div class="row g-3 mb-4"><div class="col-md-8"><label asp-for="IdProducto" class="form-label">Producto (opcional)</label><select asp-for="IdProducto" asp-items="Model.Productos" class="form-select"><option value="">Sin producto</option></select></div><div class="col-md-4"><label asp-for="CantidadProducto" class="form-label">Cantidad</label><input asp-for="CantidadProducto" class="form-control" min="1" /><span asp-validation-for="CantidadProducto" class="text-danger"></span></div></div><button class="btn btn-dark" type="submit">Guardar turno</button><a class="btn btn-outline-secondary ms-2" asp-action="Index">Volver</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
