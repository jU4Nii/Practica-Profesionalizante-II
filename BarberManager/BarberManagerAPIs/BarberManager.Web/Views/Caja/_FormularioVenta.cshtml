@model BarberManager.Web.Models.CajaViewModel

<div class="card form-card">
    <div class="card-body">
        <form method="post" id="formCaja">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Tipo de movimiento -->
            <div class="mb-3">
                <label class="form-label d-block fw-semibold">Tipo de movimiento</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="EsIngreso" value="true" id="ingreso" />
                    <label class="form-check-label" for="ingreso">Ingreso</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="EsIngreso" value="false" id="egreso" />
                    <label class="form-check-label" for="egreso">Egreso</label>
                </div>
            </div>

            <!-- Fecha -->
            <div class="mb-3">
                <label asp-for="Fecha" class="form-label">Fecha</label>
                <input asp-for="Fecha" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <!-- SECCIÓN INGRESO -->
            <div id="seccionIngreso">
                <div class="mb-3">
                    <label asp-for="TipoIngreso" class="form-label">Tipo de ingreso</label>
                    <select asp-for="TipoIngreso" class="form-select" id="tipoIngreso">
                        <option value="Venta de producto">Venta de producto</option>
                        <option value="Cobro de servicio">Cobro de servicio</option>
                        <option value="Otro ingreso">Otro ingreso</option>
                    </select>
                </div>

                <!-- Detalle cuando es Venta de producto -->
                <div id="ventaProducto" class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="IdProducto" class="form-label">Productos disponibles</label>
                        <select asp-for="IdProducto" class="form-select" id="productoVenta">
                            <option value="">Seleccioná un producto</option>
                            @foreach (var producto in Model.ProductosDisponibles)
                            {
                                <option value="@producto.Id" data-precio="@producto.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(producto.Id == Model.IdProducto)">
                                    @producto.Nombre · Stock: @producto.Cantidad · $@producto.Precio.ToString("N2")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="IdProducto" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CantidadProducto" class="form-label">Cantidad de unidades</label>
                        <input asp-for="CantidadProducto" class="form-control" id="cantidadProducto" type="number" min="1" step="1" inputmode="numeric" />
                        <span asp-validation-for="CantidadProducto" class="text-danger"></span>
                    </div>
                </div>

                <!-- Detalle cuando es Cobro de servicio / Otro ingreso -->
                <div id="campoOtroIngreso" class="mb-3 d-none">
                    <label class="form-label">Detalle del ingreso</label>
                    <input type="text" id="detalleIngreso" class="form-control" placeholder="Ej: Corte en efectivo, propina, etc." />
                </div>
            </div>

            <!-- SECCIÓN EGRESO -->
            <div id="seccionEgreso" class="d-none">
                <div class="mb-3">
                    <label class="form-label">Tipo de egreso</label>
                    <select class="form-select" id="tipoEgreso">
                        <option value="Compra de insumos">Compra de insumos</option>
                        <option value="Servicios (luz, agua, internet)">Servicios (luz, agua, internet)</option>
                        <option value="Alquiler del local">Alquiler del local</option>
                        <option value="Mantenimiento y reparaciones">Mantenimiento y reparaciones</option>
                        <option value="Sueldos y comisiones">Sueldos y comisiones</option>
                        <option value="Otro egreso">Otro egreso</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Detalle del egreso (opcional)</label>
                    <input type="text" id="detalleEgreso" class="form-control" placeholder="Ej: Cuchillas para navaja, toallas descartables, etc." />
                </div>
            </div>

            <!-- Concepto vinculado al modelo -->
            <input asp-for="Concepto" type="hidden" id="Concepto" />
            <span asp-validation-for="Concepto" class="text-danger d-block mb-2"></span>

            <!-- Monto y Método de pago -->
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Monto" class="form-label">Monto total</label>
                    <input asp-for="Monto" class="form-control" id="Monto" type="number" step="0.01" min="0.01" />
                    <div id="ayudaMonto" class="form-text">Se calcula automáticamente con el precio unitario y las unidades.</div>
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MetodoPago" class="form-label">Método de pago</label>
                    <select asp-for="MetodoPago" class="form-select">
                        <option value="Efectivo">Efectivo</option>
                        <option value="Transferencia">Transferencia</option>
                        <option value="Tarjeta">Tarjeta</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <span asp-validation-for="MetodoPago" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-dark" type="submit">Guardar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
            </div>
        </form>
    </div>
</div>
