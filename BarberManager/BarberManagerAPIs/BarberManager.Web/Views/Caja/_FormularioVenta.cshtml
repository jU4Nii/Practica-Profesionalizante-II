@model BarberManager.Web.Models.CajaViewModel
<div class="card form-card"><div class="card-body"><form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="Concepto" type="hidden" />
    <div class="mb-3"><label class="form-label d-block">Tipo de movimiento</label><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EsIngreso" value="true" id="ingreso" /><label class="form-check-label" for="ingreso">Ingreso</label></div><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EsIngreso" value="false" id="egreso" /><label class="form-check-label" for="egreso">Egreso</label></div></div>
    <div class="row g-3"><div class="col-md-6"><label asp-for="TipoIngreso" class="form-label">Tipo de ingreso</label><select asp-for="TipoIngreso" class="form-select" id="tipoIngreso"><option value="Venta de producto">Venta de producto</option><option value="Otro ingreso">Otro ingreso</option></select></div><div class="col-md-6"><label asp-for="Fecha" class="form-label">Fecha</label><input asp-for="Fecha" class="form-control" /></div></div>
    <div id="ventaProducto" class="row g-3 mt-1"><div class="col-md-8"><label asp-for="IdProducto" class="form-label">Productos disponibles</label><select asp-for="IdProducto" class="form-select" id="productoVenta"><option value="">Seleccioná un producto</option>@foreach (var producto in Model.ProductosDisponibles) { <option value="@producto.Id" data-precio="@producto.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(producto.Id == Model.IdProducto)">@producto.Nombre · Stock: @producto.Cantidad · $@producto.Precio.ToString("N2")</option> }</select><span asp-validation-for="IdProducto" class="text-danger"></span></div><div class="col-md-4"><label asp-for="CantidadProducto" class="form-label">Cantidad de unidades</label><input asp-for="CantidadProducto" class="form-control" id="cantidadProducto" type="number" min="1" step="1" inputmode="numeric" /><span asp-validation-for="CantidadProducto" class="text-danger"></span></div></div>
    <div id="campoEgreso" class="mt-3 d-none"><label class="form-label">Detalle del egreso</label><input id="detalleEgreso" class="form-control" placeholder="Ej.: Compra de insumos" /></div>
    <div class="row g-3 mt-1"><div class="col-md-6"><label asp-for="Monto" class="form-label">Monto total</label><input asp-for="Monto" class="form-control" id="Monto" step="0.01" readonly /><div id="ayudaMonto" class="form-text">Se calcula con el precio unitario y las unidades vendidas.</div></div><div class="col-md-6"><label asp-for="MetodoPago" class="form-label">Método de pago</label><select asp-for="MetodoPago" class="form-select"><option value="Efectivo">Efectivo</option><option value="Transferencia">Transferencia</option><option value="Tarjeta">Tarjeta</option><option value="Otro">Otro</option></select></div></div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-dark" type="submit">Guardar</button><a class="btn btn-outline-secondary" asp-action="Index">Volver</a></div>
</form></div></div>
