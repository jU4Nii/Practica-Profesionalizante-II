@model List<BarberManager.Web.Models.ServicioViewModel>
@{ ViewData["Title"] = "Servicios"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2 mb-0">Servicios</h1><a class="btn btn-dark" asp-action="Create">Nuevo servicio</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-info">@mensaje</div> }
@if (ViewBag.ErrorApi is string errorApi) { <div class="alert alert-warning">@errorApi</div> }
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Servicio</th><th>Precio</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach (var servicio in Model) { <tr><td>@servicio.Nombre</td><td>@servicio.Precio.ToString("C")</td><td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@servicio.Id">Editar</a><form class="d-inline" asp-action="Delete" asp-route-id="@servicio.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></td></tr> }</tbody></table></div></div>
@if (!Model.Any()) { <p class="text-muted mt-3">Todavía no hay servicios cargados.</p> }
