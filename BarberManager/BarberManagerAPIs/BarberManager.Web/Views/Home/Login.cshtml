@model BarberManager.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Inicio de sesión"; }

<section class="auth-page" aria-labelledby="login-title">
    <div class="auth-card">
        <div class="auth-avatar" aria-hidden="true"><img src="~/images/logo-tijera.png" asp-append-version="true" alt="" /></div>
        <h1 id="login-title">Inicio de sesión</h1>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

            <div class="auth-field">
                <label asp-for="Correo">Email</label>
                <input asp-for="Correo" placeholder="Email, Usuario..." autocomplete="username" />
                <span asp-validation-for="Correo" class="auth-validation"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Contrasena">Contraseña</label>
                <input asp-for="Contrasena" placeholder="Contraseña..." autocomplete="current-password" />
                <span asp-validation-for="Contrasena" class="auth-validation"></span>
            </div>

            <a class="auth-help-link" asp-action="RestablecerContrasena">¿Olvidaste tu contraseña?</a>
            <button class="auth-button" type="submit">Iniciar sesión</button>
        </form>

        <p class="auth-footer">¿Necesitás una cuenta?<br />Solicitala al administrador de la peluquería.</p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
