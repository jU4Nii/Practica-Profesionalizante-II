@model BarberManager.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Inicio de sesión"; }
<div class="login-box card shadow-sm mx-auto"><div class="card-body p-4"><h1 class="h3 text-center fw-bold mb-4">Inicio de sesión</h1><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Correo" class="form-label">Correo</label><input asp-for="Correo" class="form-control" placeholder="correo@ejemplo.com" /><span asp-validation-for="Correo" class="text-danger"></span></div><div class="mb-4"><label asp-for="Contrasena" class="form-label">Contraseña</label><input asp-for="Contrasena" class="form-control" placeholder="••••••••" /><span asp-validation-for="Contrasena" class="text-danger"></span></div><button class="btn btn-dark w-100" type="submit">Ingresar</button></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
