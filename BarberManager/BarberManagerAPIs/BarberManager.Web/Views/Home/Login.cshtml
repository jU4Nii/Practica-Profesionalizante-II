@{ ViewData["Title"] = "Inicio de sesión"; }
<div class="login-box card shadow-sm mx-auto"><div class="card-body p-4"><h1 class="h3 text-center fw-bold mb-4">Inicio de sesión</h1><form asp-action="Login" method="post"><div class="mb-3"><label class="form-label">Correo</label><input class="form-control" type="email" name="correo" placeholder="correo@ejemplo.com" /></div><div class="mb-4"><label class="form-label">Contraseña</label><input class="form-control" type="password" name="contrasena" placeholder="••••••••" /></div><button class="btn btn-dark w-100" type="submit">Ingresar</button></form><p class="text-center small text-muted mt-3 mb-0">Acceso visual temporal.</p></div></div>
