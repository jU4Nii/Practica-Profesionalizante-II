@{
    ViewData["Title"] = "Menú principal";
}

<section class="main-menu">
    <h1>BARBER MANAGER</h1>
    <h2>Menú principal</h2>
    <p class="text-muted">Hola, @Context.Session.GetString("UsuarioNombre")</p>
    <nav class="main-menu-options" aria-label="Menú principal">
        <a asp-controller="Turnos" asp-action="Index">Turnos</a>
        <a asp-controller="Clientes" asp-action="Index">Clientes</a>
        <a asp-controller="Productos" asp-action="Index">Productos</a>
        <a asp-controller="Caja" asp-action="Index">Ingresos / egresos</a>
        <a asp-controller="Estadisticas" asp-action="Index">Estadísticas</a>
        @if (Context.Session.GetString("EsAdmin") == "true") { <a asp-controller="Peluqueros" asp-action="Index">Peluqueros</a> }
    </nav>
    <form asp-controller="Home" asp-action="Logout" method="post" class="mt-4"><button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button></form>
</section>
